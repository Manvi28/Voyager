<% layout("/layouts/boilerplate.ejs")%>

    <body>
    <style>
        #filters{
            display: flex;
            flex-wrap: wrap;
        }
        .filter{
            text-align: center;
            margin-right: 2rem;
            margin-top: 1rem;
            margin-left: 1rem;
            opacity: 0.7;
        }
        .filter:hover{
            opacity: 1;
            cursor: pointer;
        }
    </style>
    <div id="filters">
        <div class="filter">
            <div><i class="fa-solid fa-fire-flame-curved"></i></div>
            <p>Trending</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-mountain-city"></i></div>
            <p>Iconic cities</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-fire-flame-curved"></i></div>
            <p>Trending</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-fire-flame-curved"></i></div>
            <p>Trending</p>
        </div>
        <div class="filter">
            <div><i class="fa-solid fa-fire-flame-curved"></i></div>
            <p>Trending</p>
        </div>

    </div>
        <div class="container">
            <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
                <% for (let listing of allListings) { %>
                    <a href="/listings/<%= listing._id%>" class="listing-links">
                        <div class="col mb-4">
                            <div class="card listingcard" style="width: 100%;">
                                <img src="<%- listing.image.url %>" class="card-img-top" alt="listing_image"
                                    style="height: 20rem;">
                                    <div class="card-img-overlay"></div>
                                <div class="card-body">
                                    <p class="card-text">
                                        <b>
                                            <%= listing.title %>
                                        </b>
                                    </p>
                                    &#8377; <%= listing.price.toLocaleString("en-in") %>
                                </div>
                            </div>
                        </div>
                    </a>

                    <% } %>
            </div>
        </div>

    </body>