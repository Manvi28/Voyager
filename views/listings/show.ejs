<% layout("/layouts/boilerplate.ejs")%>

    <div class="row">
        <div class="col-8 offset-3">
            <br /><br />
            <h3>
                <%=listing.title%>
            </h3>
        </div>

        <div class="col-6 offset-3 listingcard">
            <div class="card listingcard">
                <div class="card listingcard" style="width: 30rem;">
                    <img src="<%= listing.image.url ? listing.image.url : listing.image %>" class="show-img"
                        alt="Image">

                    <div class="card-body">
                        <p class="card-text">
                            Listed by: <b>
                                <%=listing.owner.username %>
                            </b>
                        </p>
                        <p class="card-text">
                            <%=listing.description%>
                                <p />
                                <p class="card-text">&#8377; <%=listing.price.toLocaleString("en-in")%> per night </p>
                                <p class="card-text">
                                    <%=listing.location%>
                                </p>
                                <p class="card-text">
                                    <%=listing.country%>
                                </p>


                    </div>
                </div>
            </div>
        </div>
    <% if(currentUser && currentUser._id.equals(listing.owner._id)){ %>
        <div class="row mt-3">
            <div class="col-auto offset-3">
                <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark edit-btn">Edit</a>
            </div>
            <div class="col-auto">
                <form method="post" action="/listings/<%=listing._id%>?_method=DELETE">
                    <button class="btn btn-dark">Delete</button>
                </form>
            </div>
            <br /><br /><br /><br />
        </div>
    <% } %>
        <div class="col-8 offset-3">
            <hr />
            <% if(currentUser){ %>
            <h4>Leave a Review</h4>
            <form action="/listings/<%=listing._id%>/reviews" method="post" novalidate class="needs-validation">
                <div class="mb-3 mt-3">
                    <label for="review" class="form-label">Review</label>
                    <input type="range" name="review[rating]" id="rating" min="1" max="5" class="form-range" value="3">
                </div>
                <div class="mb-3 mt-3">
                    <label for="comment" class="form-label">Comment</label>
                    <textarea name="review[comment]" id="comment" rows="5" cols="50" class="form-control"
                        required></textarea>
                </div>
                <button class="btn btn-outline-dark">Submit</button>
            </form>
            <% } %>
           
            <p><b>All Reviews</b></p>
            <div class="row">
                <% for(let review of listing.review){ %>
                    <div class="card col-5 ms-3 mb-3">
                        <div class="card-body">
                            <h5 class="card-title">@<%=review.author.username%></h5>
                            <p class="card-text">Rating: <%=review.rating%>
                            </p>
                            <p class="card-text">
                                <%=review.comment%>
                            </p>
                            <form class="mb-3" method="post"
                                action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                                <button class="btn btn-sm btn-outline-dark">Delete</button>
                            </form>
                        </div>
                    </div>
                    <% } %>
            </div>
        </div>

    </div>